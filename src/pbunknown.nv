// pbunknown — the fields a program did not recognise, kept whole.
//
// A service built against version 3 of a `.proto` file that reads a
// version 4 message, changes one field and writes it back must send
// version 4's other fields on unchanged.  Otherwise the version 4
// service at the far end loses them, and nothing logs the loss.  This
// module is where those fields wait.
//
// What is kept is the raw bytes of each field, key included, exactly
// as they arrived and in the order they arrived.  The decoded value is
// not kept: a field whose type is unknown cannot be decoded, only
// copied.  Writing the kept bytes back unchanged is also what keeps a
// signature computed over a message valid after a round trip.
//
// The set is a list, not a map.  Two arrivals of one unknown field
// number are two entries, because a repeated field is exactly that on
// the wire.

use std.bytes
use pbwire

// One field that arrived and was not recognised: its tag, and the bytes
// it occupied.
pub struct PbUnknown
    // The tag as it was read.
    tag: PbTag
    // The field's bytes, key included, exactly as they arrived.  For a
    // group that is both keys and everything between them.
    raw: Bytes

// The kept fields of one message, in arrival order.
pub struct PbUnknownSet
    fields: [PbUnknown]

// An empty set, which is what a message with nothing unknown in it
// carries.
//
// ```novo
// use pbunknown
//
// fn main() [io]
//     println("${pbunknown.count(pbunknown.empty())}")   // 0
// ```
pub fn empty() -> PbUnknownSet []
    PbUnknownSet { fields: [] }

// A new set holding `u`'s fields and then one more.
//
// `raw` is the whole field including its key, which is what a
// `pbread.PbFieldSeen` event measures with `at` and `raw_len`.
pub fn keep(u: PbUnknownSet, t: PbTag, raw: Bytes) -> PbUnknownSet []
    var fields = list.clone(u.fields)
    list.push(fields, PbUnknown { tag: t, raw: raw })
    PbUnknownSet { fields: fields }

// How many fields the set holds.
pub fn count(u: PbUnknownSet) -> Int []
    list.len(u.fields)

// The kept fields, in arrival order.
pub fn fields_of(u: PbUnknownSet) -> [PbUnknown] []
    list.clone(u.fields)

// Every kept field whose number is `field`, in arrival order.
pub fn by_number(u: PbUnknownSet, field: Int) -> [PbUnknown] []
    var out: [PbUnknown] = []
    for f in u.fields
        if f.tag.field == field
            list.push(out, f)
    out

// Whether the set holds anything with this field number.
pub fn has_number(u: PbUnknownSet, field: Int) -> Bool []
    for f in u.fields
        if f.tag.field == field
            return true
    false

// A new set without the fields of this number.
//
// A program that has learned a field calls this once it has decoded
// the kept bytes, so that they are not written twice.
pub fn drop_number(u: PbUnknownSet, field: Int) -> PbUnknownSet []
    var out: [PbUnknown] = []
    for f in u.fields
        if f.tag.field != field
            list.push(out, f)
    PbUnknownSet { fields: out }

// A new set with `a`'s fields and then `b`'s.
//
// Protobuf's merge of two messages is the concatenation of their
// bytes, so their unknown sets concatenate too.
pub fn merge(a: PbUnknownSet, b: PbUnknownSet) -> PbUnknownSet []
    PbUnknownSet { fields: list.concat(a.fields, b.fields) }

// How many bytes the set occupies when it is written back out: the sum
// of the kept lengths.
pub fn encoded_len(u: PbUnknownSet) -> Int []
    var n = 0
    for f in u.fields
        n = n + bytes.len(f.raw)
    n

// Write the kept fields into the caller's buffer, in arrival order, and
// answer the byte count.
//
// `PbBufferTooSmall` when the cursor has less room than `encoded_len`,
// before anything is written.
//
// ```novo
// use std.bytes
// use pbunknown
//
// fn main() [io]
//     let u = pbunknown.empty()
//     var c = bytes.cursor_le(bytes.zeros(pbunknown.encoded_len(u)))
//     match pbunknown.write_into(u, c)
//         Ok(n)  => println("${n}")   // 0
//         Err(e) => println(e.message())
// ```
pub fn write_into(u: PbUnknownSet, var dst: Cursor) -> Result<Int, PbEncodeError> []
    let need = encoded_len(u)
    if dst.remaining() < need
        return Err(PbBufferTooSmall(need: need, left: dst.remaining()))
    for f in u.fields
        dst.put_bytes(f.raw)
    Ok(need)
