// pbread — one message, read field by field, with no schema.
//
// The host feeds chunks in and takes finished fields out.  A protobuf
// message is read strictly left to right, with no index and nothing to
// seek to, so a reader needs to hold only the field it is inside.
//
// A message is not self-delimiting.  It has no header, no length and
// no end marker, so something outside the format says where it stops:
// gRPC's five-byte frame, a file's own length prefix, or the
// length-delimited field a submessage travels in.  `feed` therefore
// never announces the end of a message, and `finish` is how the host
// says that the message ends.
//
// The events carry the wire shape and the raw bytes, not typed values.
// A length-delimited field may be a string, a byte string, a
// submessage or a packed repeated field, and only a schema says which.
// `pbdyn` puts a descriptor over the events; generated code does the
// same with the schema compiled in.
//
// The reader refuses what is not protobuf: wire codes 6 and 7, a zero
// field number, a varint past ten bytes, a length past the end, and
// nesting past the limit.  It reads everything else, including field
// numbers in the descriptor language's reserved range.

use std.bytes
use pbwire
use pbunknown
use pberr

// What a reader will not do, whatever the input asks.
//
// Both bounds defend against the sender.  A length-delimited field is
// an instruction to set aside memory, and the specification puts no
// bound on nesting.
pub struct PbLimits
    // How deep groups and submessages may nest.
    max_depth: Int
    // The most bytes one message may occupy.
    max_message: Int
    // Whether a `string` field's bytes are checked for UTF-8.  Only a
    // reader with a schema knows which fields are strings, so this
    // applies in `pbdyn` and in generated code.
    check_utf8: Bool

// The limits a server starts from: depth 100, a 64 MiB message, UTF-8
// checked.  The depth is the one the C++ implementation uses.
//
// ```novo
// use pbread
//
// fn main() [io]
//     println("${pbread.default_limits().max_depth}")   // 100
// ```
pub fn default_limits() -> PbLimits []
    PbLimits { max_depth: 100, max_message: 64 * 1024 * 1024, check_utf8: true }

// The limits for messages from a source that is not trusted: depth 32,
// a 1 MiB message, UTF-8 checked.
pub fn strict_limits() -> PbLimits []
    PbLimits { max_depth: 32, max_message: 1024 * 1024, check_utf8: true }

// One field's payload, in the shape its key announced.
//
// A varint may be any of eight declared types, and only a schema says
// which, so the payload is kept as the wire has it.
pub enum PbRaw
    // Wire type 0: the varint's sixty-four-bit pattern.
    PbRawVarint(bits: Int)
    // Wire type 1: eight little-endian bytes as a sixty-four-bit
    // pattern.
    PbRawFixed64(bits: Int)
    // Wire type 2: the payload, without the key and the length prefix.
    PbRawBytes(data: Bytes)
    // Wire type 5: four little-endian bytes as a value in
    // `0 ..= 2^32 - 1`.
    PbRawFixed32(bits: Int)

// The bit pattern a varint or fixed-width payload holds, or 0 for a
// length-delimited one.
//
// ```novo
// use pbread
//
// fn main() [io]
//     println("${pbread.bits_of(PbRawFixed32(bits: 7))}")   // 7
// ```
pub fn bits_of(v: PbRaw) -> Int []
    match v
        PbRawVarint(b)  => b
        PbRawFixed64(b) => b
        PbRawFixed32(b) => b
        PbRawBytes(_)   => 0

// The bytes a length-delimited payload holds, or an empty buffer for
// another shape.
pub fn data_of(v: PbRaw) -> readonly Bytes []
    match v
        PbRawBytes(d) => d
        _             => bytes.zeros(0)

// What a reader produced.
//
// `PbGroupStart` and `PbGroupEnd` bracket a proto2 group's fields.  A
// submessage is one `PbFieldSeen` with a `PbRawBytes` payload, because
// only a schema says that a length-delimited field is a submessage.
pub enum PbEvent
    // A whole field.  `at` is the offset of its key and `raw_len` the
    // bytes it occupies, key included.
    PbFieldSeen(tag: PbTag, value: PbRaw, at: Int, raw_len: Int)
    // A group opened with this field number.  `at` is the offset of
    // the key.
    PbGroupStart(field: Int, at: Int)
    // A group closed with this field number.
    PbGroupEnd(field: Int, at: Int)

// One turn of the reader: the reader after the step, the events it
// produced, and a hint of how many more bytes it wants.
//
// `need` is 0 when the reader is between fields.  Inside a varint it is
// 1, because a varint announces no length.
pub struct PbStep
    reader: PbReader
    events: [PbEvent]
    need: Int

// A message being read: the fed bytes not yet consumed, the open
// groups, and the count of bytes consumed.
//
// The fields are the reader's state.  The accessors below are the
// interface a caller relies on.
pub struct PbReader
    limits: PbLimits
    pending: Bytes
    offset: Int
    depth: Int
    groups: [Int]

// A fresh reader over one message.
pub fn reader(limits: PbLimits) -> PbReader []
    PbReader { limits: limits, pending: bytes.zeros(0), offset: 0, depth: 0, groups: [] }

// What one scan at a position found: an event and its length, or a
// field that has not finished arriving and how much more it needs.
enum PbScan
    PbScanEvent(ev: PbEvent, len: Int)
    PbScanNeed(need: Int)

// Scan the item at `pos` in `buf`, whose first byte is byte `base` of
// the message.
//
// With `final` false, input that ends inside an item answers
// `PbScanNeed`.  With `final` true the end of `buf` is the end of the
// message, and it answers the refusal.
fn scan(buf: Bytes, pos: Int, base: Int, final: Bool,
        limits: PbLimits) -> Result<PbScan, PbDecodeError>
    let at = base + pos
    let k = match pbwire.read_tag_at(buf, pos)
        Ok(k)  => k
        Err(e) =>
            return need_or(e, final, base)
    let body = pos + k.len
    let t = k.tag
    match t.wire
        PbWireVarint     =>
            match pbwire.read_varint_at(buf, body)
                Ok(v)  => field(t, PbRawVarint(bits: v.value), at, k.len + v.len)
                Err(e) => need_or(e, final, base)
        PbWireFixed64    => fixed(buf, t, body, at, k.len, 8, final, base)
        PbWireFixed32    => fixed(buf, t, body, at, k.len, 4, final, base)
        PbWireBytes      => delimited(buf, t, body, at, k.len, final, base, limits)
        PbWireStartGroup => Ok(PbScanEvent(ev: PbGroupStart(field: t.field, at: at), len: k.len))
        PbWireEndGroup   => Ok(PbScanEvent(ev: PbGroupEnd(field: t.field, at: at), len: k.len))

fn field(t: PbTag, v: PbRaw, at: Int, len: Int) -> Result<PbScan, PbDecodeError>
    Ok(PbScanEvent(ev: PbFieldSeen(tag: t, value: v, at: at, raw_len: len), len: len))

// A truncation becomes a wait unless the input is final.  Every
// refusal takes its offset in the message.
fn need_or(e: PbDecodeError, final: Bool, base: Int) -> Result<PbScan, PbDecodeError>
    match e
        PbTruncated(_, need) =>
            if not final
                return Ok(PbScanNeed(need: need))
        _                    => ()
    Err(pberr.shifted(e, base))

fn fixed(buf: Bytes, t: PbTag, body: Int, at: Int, klen: Int, n: Int, final: Bool,
         base: Int) -> Result<PbScan, PbDecodeError>
    let have = bytes.len(buf) - body
    if have < n
        if final
            return Err(PbTruncated(at: base + body, need: n - have))
        return Ok(PbScanNeed(need: n - have))
    if n == 8
        let v = pbwire.read_fixed64_at(buf, body)!
        return field(t, PbRawFixed64(bits: v.value), at, klen + 8)
    let v = pbwire.read_fixed32_at(buf, body)!
    field(t, PbRawFixed32(bits: v.value), at, klen + 4)

fn delimited(buf: Bytes, t: PbTag, body: Int, at: Int, klen: Int, final: Bool, base: Int,
             limits: PbLimits) -> Result<PbScan, PbDecodeError>
    let p = match pbwire.read_varint_at(buf, body)
        Ok(p)  => p
        Err(e) =>
            return need_or(e, final, base)
    if p.value < 0
        return Err(PbLengthNotRepresentable(at: base + body))
    let start = body + p.len
    let left = bytes.len(buf) - start
    if final and p.value > left
        return Err(PbLengthOverrun(at: base + body, len: p.value, left: left))
    if base + start > limits.max_message - p.value
        return Err(PbMessageTooLarge(at: at, len: base + start + p.value, limit: limits.max_message))
    if p.value > left
        return Ok(PbScanNeed(need: p.value - left))
    let data = bytes.slice(buf, start, start + p.value)
    field(t, PbRawBytes(data: data), at, klen + p.len + p.value)

// The result of scanning a buffer as far as it goes.
struct PbRun
    var events: [PbEvent]
    used: Int
    // The field numbers of the open groups, the outermost first.  Only
    // the first `depth` entries are live.
    var groups: [Int]
    depth: Int
    need: Int

// Scan `buf` from its start, collecting events until the input runs
// out or, with `final` false, stops inside a field.
fn run(buf: Bytes, base: Int, final: Bool, limits: PbLimits, groups: [Int],
       depth: Int) -> Result<PbRun, PbDecodeError>
    var events: [PbEvent] = []
    var open = list.clone(groups)
    var d = depth
    var pos = 0
    var need = 0
    let n = bytes.len(buf)
    while pos < n and need == 0
        match scan(buf, pos, base, final, limits)!
            PbScanNeed(k)        =>
                need = k
            PbScanEvent(ev, len) =>
                d = enter(open, d, ev, limits)!
                list.push(events, ev)
                pos = pos + len
    Ok(PbRun { events: events, used: pos, groups: open, depth: d, need: need })

// Track the group stack across one event, and answer the new depth.
//
// A group's start pushes its number, and its end pops it.
// `PbDepthExceeded` past the depth limit, and `PbGroupMismatch` for an
// end that does not close the innermost open group.
fn enter(var open: [Int], depth: Int, ev: PbEvent, limits: PbLimits) -> Result<Int, PbDecodeError>
    match ev
        PbGroupStart(f, at)     =>
            if depth >= limits.max_depth
                return Err(PbDepthExceeded(at: at, limit: limits.max_depth))
            if depth < list.len(open)
                open[depth] = f
            else
                list.push(open, f)
            Ok(depth + 1)
        PbGroupEnd(f, at)       =>
            let top = if depth > 0
                open[depth - 1]
            else
                0
            if top != f
                return Err(PbGroupMismatch(at: at, closed: f, open: top))
            Ok(depth - 1)
        PbFieldSeen(_, _, _, _) => Ok(depth)

// The innermost open group, or `None`.
fn innermost(r: PbRun) -> ?Int
    if r.depth == 0
        return None
    Some(r.groups[r.depth - 1])

// Feed a chunk and take every field that finished.
//
// A field split across two chunks stays pending until the rest
// arrives.  A chunk that finishes nothing answers an empty event list,
// which on a socket is the ordinary case.  `PbMessageTooLarge` as soon
// as the bytes fed, or a length announced, pass the limit.
//
// ```novo
// use std.bytes
// use pbread
//
// fn main() [io]
//     // field 1, length-delimited, "abc".
//     let buf = bytes.from_hex("0a03616263") ?? bytes.zeros(0)
//     match pbread.feed(pbread.reader(pbread.default_limits()), bytes.to_byte_list(buf))
//         Ok(s)  => println("${s.events.len()}")   // 1
//         Err(e) => println(e.message())
// ```
pub fn feed(r: PbReader, chunk: [u8]) -> Result<PbStep, PbDecodeError> []
    let buf = bytes.concat([r.pending, bytes.from_byte_list(chunk)])
    let total = r.offset + bytes.len(buf)
    if total > r.limits.max_message
        return Err(PbMessageTooLarge(at: r.offset, len: total, limit: r.limits.max_message))
    let got = run(buf, r.offset, false, r.limits, r.groups, r.depth)!
    let rest = bytes.slice(buf, got.used, bytes.len(buf))
    let next = PbReader { limits: r.limits, pending: rest, offset: r.offset + got.used,
        depth: got.depth, groups: got.groups }
    Ok(PbStep { reader: next, events: got.events, need: got.need })

// Say that the message ends here.
//
// Bytes still pending are `PbTruncated`, or `PbLengthOverrun` inside a
// length-delimited field.  A group still open is `PbUnclosedGroup`.  A
// message that ends cleanly answers a step with no events and `need`
// 0.
pub fn finish(r: PbReader) -> Result<PbStep, PbDecodeError> []
    let got = run(r.pending, r.offset, true, r.limits, r.groups, r.depth)!
    let end = r.offset + got.used
    if let Some(f) = innermost(got)
        return Err(PbUnclosedGroup(at: end, field: f))
    let next = PbReader { limits: r.limits, pending: bytes.zeros(0), offset: end,
        depth: 0, groups: [] }
    Ok(PbStep { reader: next, events: got.events, need: 0 })

// How many bytes the reader has consumed since it was made.  Every
// `PbDecodeError` offset counts in the same unit.
pub fn offset(r: PbReader) -> Int []
    r.offset

// How many fed bytes are waiting for the rest of their field.
pub fn pending_len(r: PbReader) -> Int []
    bytes.len(r.pending)

// How many groups are open.
pub fn depth(r: PbReader) -> Int []
    r.depth

// Whether the reader is between fields with no group open, and so
// would accept `finish`.
pub fn at_boundary(r: PbReader) -> Bool []
    bytes.len(r.pending) == 0 and r.depth == 0

// ── the whole-buffer forms ───────────────────────────────────────────

// Every field of a message the caller holds whole.
//
// `PbMessageTooLarge` before anything is read when `src` is longer
// than the limit.
//
// ```novo
// use std.bytes
// use pbread
//
// fn main() [io]
//     let buf = bytes.from_hex("089601") ?? bytes.zeros(0)
//     match pbread.walk(buf, pbread.default_limits())
//         Ok(evs) => println("${evs.len()}")   // 1: field 1, varint 150
//         Err(e)  => println(e.message())
// ```
pub fn walk(src: Bytes, limits: PbLimits) -> Result<[PbEvent], PbDecodeError> []
    walk_from(src, 0, limits)

fn walk_from(src: Bytes, base: Int, limits: PbLimits) -> Result<[PbEvent], PbDecodeError>
    let n = bytes.len(src)
    if n > limits.max_message
        return Err(PbMessageTooLarge(at: base, len: n, limit: limits.max_message))
    let got = run(src, base, true, limits, [], 0)!
    if let Some(f) = innermost(got)
        return Err(PbUnclosedGroup(at: base + n, field: f))
    Ok(got.events)

// Every field of the `len` bytes at `off` in `src`, with offsets
// counted in `src`.
//
// What a caller re-entering a submessage calls.  `PbLengthOverrun`
// when the range passes the end of `src`.
pub fn walk_range(src: Bytes, off: Int, len: Int,
                  limits: PbLimits) -> Result<[PbEvent], PbDecodeError> []
    let left = bytes.len(src) - off
    if off < 0 or len < 0 or len > left
        return Err(PbLengthOverrun(at: off, len: len, left: left))
    walk_from(bytes.slice(src, off, off + len), off, limits)

// Every element of a packed repeated field, decoded as `t`.
//
// A varint type answers `PbRawVarint`s, a four-byte type
// `PbRawFixed32`s and an eight-byte type `PbRawFixed64`s.
// `PbPackedRemainder` when the payload does not divide into whole
// elements or `t` may not be packed.
pub fn unpack(data: Bytes, t: PbFieldType) -> Result<[PbRaw], PbDecodeError> []
    let n = bytes.len(data)
    let _ = pbwire.packed_element_count(data, 0, n, t)!
    var out: [PbRaw] = []
    var i = 0
    match pbwire.wire_for(t)
        PbWireFixed64 =>
            while i < n
                list.push(out, PbRawFixed64(bits: pbwire.read_fixed64_at(data, i)!.value))
                i = i + 8
        PbWireFixed32 =>
            while i < n
                list.push(out, PbRawFixed32(bits: pbwire.read_fixed32_at(data, i)!.value))
                i = i + 4
        _             =>
            while i < n
                let v = pbwire.read_varint_at(data, i)!
                list.push(out, PbRawVarint(bits: v.value))
                i = i + v.len
    Ok(out)

// ── keeping what is not known ────────────────────────────────────────

// A message split into the fields a schema declared and the fields it
// did not.
pub struct PbPartition
    // The events of the declared fields, groups bracketed, in arrival
    // order.
    known: [PbEvent]
    // The other fields, kept whole.
    unknown: PbUnknownSet

// Split a message's top-level fields into the ones `wanted` names and
// the ones it does not.
//
// The second half is what a program writes back out unchanged.  A
// group whose number is not wanted is kept as one field, both keys
// included.
//
// ```novo
// use std.bytes
// use pbread
// use pbunknown
//
// fn main() [io]
//     let buf = bytes.from_hex("089601") ?? bytes.zeros(0)
//     match pbread.partition(buf, [2], pbread.default_limits())
//         Ok(p)  => println("${pbunknown.count(p.unknown)}")   // 1
//         Err(e) => println(e.message())
// ```
pub fn partition(src: Bytes, wanted: [Int],
                 limits: PbLimits) -> Result<PbPartition, PbDecodeError> []
    let evs = walk(src, limits)!
    var known: [PbEvent] = []
    var unknown = pbunknown.empty()
    var depth = 0
    var keep_group = false
    var group_at = 0
    for ev in evs
        match ev
            PbFieldSeen(t, _, at, raw_len) =>
                if depth > 0
                    if not keep_group
                        list.push(known, ev)
                else if list.contains(wanted, t.field)
                    list.push(known, ev)
                else
                    unknown = pbunknown.keep(unknown, t, bytes.slice(src, at, at + raw_len))
            PbGroupStart(f, at)            =>
                if depth == 0
                    keep_group = not list.contains(wanted, f)
                    group_at = at
                if not keep_group
                    list.push(known, ev)
                depth = depth + 1
            PbGroupEnd(f, at)              =>
                depth = depth - 1
                if not keep_group
                    list.push(known, ev)
                else if depth == 0
                    let end = at + pbwire.key_len(pbwire.tag(f, PbWireEndGroup))
                    let t = pbwire.tag(f, PbWireStartGroup)
                    unknown = pbunknown.keep(unknown, t, bytes.slice(src, group_at, end))
    Ok(PbPartition { known: known, unknown: unknown })

// ── the bound effect parameter ───────────────────────────────────────

// Read one whole message of `limit` bytes from the caller's source.
//
// The loop is written once here and charged whatever the caller's
// source costs: `[io]` for a socket, nothing for a buffer (SPEC section
// 5.6).  The host passes the length, because a protobuf message is not
// self-delimiting.  A source that ends before `limit` bytes is
// `PbTruncated`, and one that fails is `PbTransport`.
//
// A caller that must keep control of its own loop uses `feed` and
// `finish` instead.
pub fn drain<S: Read[e]>(r: PbReader, src: S, limit: Int) -> Result<PbStep, PbDecodeError> [e]
    var cur = r
    var events: [PbEvent] = []
    var got = 0
    while got < limit
        let want = if limit - got < 4096
            limit - got
        else
            4096
        let chunk = match src.read(want)
            Ok(c)  => c
            Err(e) =>
                return Err(PbTransport(at: cur.offset + pending_len(cur), cause: e))
        let n = bytes.len(chunk)
        if n == 0
            return Err(PbTruncated(at: cur.offset + pending_len(cur), need: limit - got))
        let step = feed(cur, bytes.to_byte_list(chunk))!
        list.append(events, step.events)
        cur = step.reader
        got = got + n
    let last = finish(cur)!
    list.append(events, last.events)
    Ok(PbStep { reader: last.reader, events: events, need: 0 })
