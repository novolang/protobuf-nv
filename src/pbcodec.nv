// pbcodec — the calls that code generated by `pbgen` makes.
//
// A generated decoder takes a message's top-level fields as pieces and
// asks each piece for a value of its declared type.  A piece whose wire
// type does not match the declared type answers `None`, and the
// decoder keeps it as an unknown field, as the specification asks.  A
// generated encoder sizes a message first with the `*_len` functions
// and then writes it once with the `write_*` functions, which are
// `pbwrite`'s writers chosen by declared type.
//
// These functions are public so that generated code can call them, and
// they are usable by hand.  Their names and signatures are part of the
// generated-code contract, like the names `pbgen` answers.

use std.bytes
use zigzag
use pbwire
use pbread
use pbunknown
use pbwrite

// One top-level field of a message: its tag, its payload, where its key
// is, and the bytes it occupies with the key.
//
// A group arrives as one piece whose tag is its start key, whose
// payload is empty, and whose length runs to the end of its end key.
pub struct PbPiece
    tag: PbTag
    value: PbRaw
    at: Int
    len: Int

// The top-level fields of a message, in arrival order.
//
// ```novo
// use std.bytes
// use pbcodec
// use pbread
//
// fn main() [io]
//     let buf = bytes.from_hex("0896010b0c") ?? bytes.zeros(0)
//     match pbcodec.pieces(buf, pbread.default_limits())
//         Ok(ps) => println("${ps.len()}")   // 2: field 1, and the group of field 1
//         Err(e) => println(e.message())
// ```
pub fn pieces(src: Bytes, limits: PbLimits) -> Result<[PbPiece], PbDecodeError> []
    pieces_in(src, 0, bytes.len(src), limits)

// The top-level fields of the `len` bytes at `off` in `src`, with
// offsets counted in `src`.  `PbLengthOverrun` when the range passes
// the end of `src`.
pub fn pieces_in(src: Bytes, off: Int, len: Int, limits: PbLimits) -> Result<[PbPiece], PbDecodeError> []
    let evs = pbread.walk_range(src, off, len, limits)!
    var out: [PbPiece] = []
    var depth = 0
    var start = 0
    for ev in evs
        match ev
            PbFieldSeen(t, v, at, raw_len) =>
                if depth == 0
                    list.push(out, PbPiece { tag: t, value: v, at: at, len: raw_len })
            PbGroupStart(_, at)            =>
                if depth == 0
                    start = at
                depth = depth + 1
            PbGroupEnd(f, at)              =>
                depth = depth - 1
                if depth == 0
                    let end = at + pbwire.key_len(pbwire.tag(f, PbWireEndGroup))
                    list.push(out, PbPiece { tag: pbwire.tag(f, PbWireStartGroup),
                        value: PbRawBytes(data: bytes.zeros(0)), at: start, len: end - start })
    Ok(out)

// A new unknown set with the piece's bytes, key included, added at the
// end.
pub fn keep(u: PbUnknownSet, src: Bytes, p: PbPiece) -> PbUnknownSet []
    pbunknown.keep(u, p.tag, bytes.slice(src, p.at, p.at + p.len))

// The limits a submessage is read under: one level less depth.
// `PbDepthExceeded` at `at` when no depth is left.
pub fn nested(limits: PbLimits, at: Int) -> Result<PbLimits, PbDecodeError> []
    if limits.max_depth <= 0
        return Err(PbDepthExceeded(at: at, limit: 0))
    Ok(PbLimits { max_depth: limits.max_depth - 1, max_message: limits.max_message,
        check_utf8: limits.check_utf8 })

// Whether the piece's wire type is the one `t` travels as.
fn fits(p: PbPiece, t: PbFieldType) -> Bool
    p.tag.wire == pbwire.wire_for(t)

// The integer a raw payload holds as a value of type `t`.
fn int_from(v: PbRaw, t: PbFieldType) -> Int
    let b = pbread.bits_of(v)
    match t
        PbTypeInt32    => pbwire.int32_of_wire(b)
        PbTypeEnum     => pbwire.int32_of_wire(b)
        PbTypeSfixed32 => pbwire.int32_of_wire(b)
        PbTypeUint32   => b & 0xffffffff
        PbTypeSint32   => zigzag.decode32(b)
        PbTypeSint64   => zigzag.decode64(b)
        _              => b

// The integer a piece holds as type `t`, or `None` when its wire type
// is not `t`'s.
//
// `t` is one of the integral types or `enum`.  `int32`, `sfixed32` and
// `enum` are read back to their signed thirty-two-bit value, `uint32`
// to its low thirty-two bits, and the `sint` types are unfolded.
pub fn int_of(p: PbPiece, t: PbFieldType) -> ?Int []
    if not fits(p, t)
        return None
    Some(int_from(p.value, t))

fn real_from(v: PbRaw, t: PbFieldType) -> Float
    if t == PbTypeFloat
        return pbwire.float_of_bits32(pbread.bits_of(v))
    float.from_bits(pbread.bits_of(v))

// The number a `double` or `float` piece holds, or `None` when its wire
// type is not `t`'s.
pub fn real_of(p: PbPiece, t: PbFieldType) -> ?Float []
    if not fits(p, t)
        return None
    Some(real_from(p.value, t))

// The value a `bool` piece holds, or `None` when it is not a varint.
pub fn flag_of(p: PbPiece) -> ?Bool []
    match p.value
        PbRawVarint(b) => Some(b != 0)
        _              => None

// The text a `string` piece holds, or `None` when it is not
// length-delimited.  `PbNotUtf8` when the limits check UTF-8 and the
// bytes are not.
pub fn text_of(p: PbPiece, limits: PbLimits) -> Result<?Str, PbDecodeError> []
    let PbRawBytes(d) = p.value else return Ok(None)
    if limits.check_utf8
        let bad = pbwire.first_non_utf8(d, 0, bytes.len(d))
        if bad >= 0
            let start = p.at + p.len - bytes.len(d)
            return Err(PbNotUtf8(at: start + bad, byte: bytes.byte_at(d, bad) ?? 0))
    Ok(Some(bytes.to_str(d)))

// The bytes a length-delimited piece holds, or `None` for another wire
// type.  A `bytes` field and a submessage both read this way.
pub fn octets_of(p: PbPiece) -> ?Bytes []
    match p.value
        PbRawBytes(d) => Some(bytes.clone(d))
        _             => None

// The elements of a repeated integral field in one piece: several when
// it arrived packed, one when it did not, and `None` when the wire
// type fits neither form.
pub fn ints_of(p: PbPiece, t: PbFieldType) -> Result<?[Int], PbDecodeError> []
    if fits(p, t)
        return Ok(Some([int_from(p.value, t)]))
    let PbRawBytes(d) = p.value else return Ok(None)
    var out: [Int] = []
    for r in pbread.unpack(d, t)!
        list.push(out, int_from(r, t))
    Ok(Some(out))

// The elements of a repeated `double` or `float` field in one piece,
// packed or not.
pub fn reals_of(p: PbPiece, t: PbFieldType) -> Result<?[Float], PbDecodeError> []
    if fits(p, t)
        return Ok(Some([real_from(p.value, t)]))
    let PbRawBytes(d) = p.value else return Ok(None)
    var out: [Float] = []
    for r in pbread.unpack(d, t)!
        list.push(out, real_from(r, t))
    Ok(Some(out))

// The elements of a repeated `bool` field in one piece, packed or not.
pub fn flags_of(p: PbPiece) -> Result<?[Bool], PbDecodeError> []
    match p.value
        PbRawVarint(b) => Ok(Some([b != 0]))
        PbRawBytes(d)  =>
            var out: [Bool] = []
            for r in pbread.unpack(d, PbTypeBool)!
                list.push(out, int_from(r, PbTypeBool) != 0)
            Ok(Some(out))
        _              => Ok(None)

// ── sizing and writing ───────────────────────────────────────────────

// How many bytes an integral field of type `t` holding `v` occupies.
pub fn int_len(field: Int, t: PbFieldType, v: Int) -> Int []
    match t
        PbTypeInt32  => pbwrite.int32_field_len(field, v)
        PbTypeEnum   => pbwrite.int32_field_len(field, v)
        PbTypeSint32 => pbwrite.sint32_field_len(field, v)
        PbTypeSint64 => pbwrite.sint64_field_len(field, v)
        _            =>
            if pbwire.fixed_width(pbwire.wire_for(t)) > 0
                return pbwrite.fixed_field_len(field, t)
            pbwrite.varint_field_len(field, v)

// Write an integral field of type `t` holding `v`.
//
// `PbValueOutOfRange` for a value a thirty-two-bit type cannot carry.
pub fn write_int(field: Int, t: PbFieldType, v: Int, var dst: Cursor) -> Result<Int, PbEncodeError> []
    match t
        PbTypeSint32   => pbwrite.write_sint32_field(field, v, dst)
        PbTypeSint64   => pbwrite.write_sint64_field(field, v, dst)
        PbTypeFixed32  => pbwrite.write_fixed32_field(field, v, dst)
        PbTypeSfixed32 => pbwrite.write_fixed32_field(field, v, dst)
        PbTypeFixed64  => pbwrite.write_fixed64_field(field, v, dst)
        PbTypeSfixed64 => pbwrite.write_fixed64_field(field, v, dst)
        _              =>
            if not fits32(t, v)
                return Err(PbValueOutOfRange(field: field, value: v))
            pbwrite.write_varint_field(field, v, dst)

fn fits32(t: PbFieldType, v: Int) -> Bool
    match t
        PbTypeInt32  => zigzag.fits32(v)
        PbTypeEnum   => zigzag.fits32(v)
        PbTypeUint32 => v >= 0 and v <= 0xffffffff
        _            => true

// How many bytes a `double` or `float` field occupies.
pub fn real_len(field: Int, t: PbFieldType) -> Int []
    pbwrite.fixed_field_len(field, t)

// Write a `double` or `float` field.
pub fn write_real(field: Int, t: PbFieldType, v: Float, var dst: Cursor) -> Result<Int, PbEncodeError> []
    if t == PbTypeFloat
        return pbwrite.write_float_field(field, v, dst)
    pbwrite.write_double_field(field, v, dst)

// How many bytes a repeated integral field occupies, packed or with a
// key per element.  An empty field occupies nothing.
pub fn ints_len(field: Int, t: PbFieldType, vs: [Int], packed: Bool) -> Int []
    if list.len(vs) == 0
        return 0
    if packed
        return pbwrite.delimited_field_len(field, pbwrite.packed_payload_len(t, vs))
    var n = 0
    for v in vs
        n = n + int_len(field, t, v)
    n

// Write a repeated integral field, packed or with a key per element.
// An empty field writes nothing.
pub fn write_ints(field: Int, t: PbFieldType, vs: [Int], packed: Bool,
                  var dst: Cursor) -> Result<Int, PbEncodeError> []
    if list.len(vs) == 0
        return Ok(0)
    if packed
        return pbwrite.write_packed_field(field, t, vs, dst)
    var n = 0
    for v in vs
        n = n + write_int(field, t, v, dst)!
    Ok(n)

// The bit patterns a packed `float` or `double` field is written from.
fn real_bits(t: PbFieldType, vs: [Float]) -> [Int]
    var out: [Int] = []
    for v in vs
        list.push(out, if t == PbTypeFloat then pbwire.float32_bits(v) else float.to_bits(v))
    out

// How many bytes a repeated `double` or `float` field occupies.
pub fn reals_len(field: Int, t: PbFieldType, vs: [Float], packed: Bool) -> Int []
    if list.len(vs) == 0
        return 0
    if packed
        return pbwrite.delimited_field_len(field, pbwrite.packed_payload_len(t, real_bits(t, vs)))
    list.len(vs) * real_len(field, t)

// Write a repeated `double` or `float` field.
pub fn write_reals(field: Int, t: PbFieldType, vs: [Float], packed: Bool,
                   var dst: Cursor) -> Result<Int, PbEncodeError> []
    if list.len(vs) == 0
        return Ok(0)
    if packed
        return pbwrite.write_packed_field(field, t, real_bits(t, vs), dst)
    var n = 0
    for v in vs
        n = n + write_real(field, t, v, dst)!
    Ok(n)

fn flag_bits(vs: [Bool]) -> [Int]
    var out: [Int] = []
    for v in vs
        list.push(out, if v then 1 else 0)
    out

// How many bytes a repeated `bool` field occupies.
pub fn flags_len(field: Int, vs: [Bool], packed: Bool) -> Int []
    ints_len(field, PbTypeBool, flag_bits(vs), packed)

// Write a repeated `bool` field.
pub fn write_flags(field: Int, vs: [Bool], packed: Bool,
                   var dst: Cursor) -> Result<Int, PbEncodeError> []
    write_ints(field, PbTypeBool, flag_bits(vs), packed, dst)

// How many bytes a `bool` field occupies.
pub fn flag_len(field: Int) -> Int []
    pbwrite.varint_field_len(field, 1)

// How many bytes a `string` field holding `s` occupies.
pub fn text_len(field: Int, s: Str) -> Int []
    pbwrite.delimited_field_len(field, str.len(s))

// How many bytes a `bytes` field holding `b` occupies.
pub fn octets_len(field: Int, b: Bytes) -> Int []
    pbwrite.delimited_field_len(field, bytes.len(b))

// How many bytes a submessage field whose body is `body` bytes
// occupies.
pub fn nested_len(field: Int, body: Int) -> Int []
    pbwrite.delimited_field_len(field, body)

// Write a submessage field's key and length prefix, and answer their
// byte count.  The caller writes the body next.
pub fn write_nested_head(field: Int, body: Int, var dst: Cursor) -> Result<Int, PbEncodeError> []
    let k = pbwire.write_tag_into(pbwire.tag(field, PbWireBytes), dst)!
    Ok(k + pbwire.write_varint_into(body, dst)!)
