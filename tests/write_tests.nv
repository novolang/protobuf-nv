// tests/write_tests.nv — the field writers' refusals and sizes, the
// builder's limits, and the offset of a refusal moved into an outer
// message.

use std.test
use std.bytes
use pbread
use pbwrite
use pberr

fn hex(h: Str) -> Bytes
    bytes.from_hex(h) ?? bytes.zeros(0)

fn refusal(r: Result<Int, PbEncodeError>) -> PbEncodeError
    match r
        Ok(_)  =>
            test.fail("expected a refusal")
            PbBadFieldNumber(field: 0 - 1)
        Err(e) => e

fn built(r: Result<PbBuilder, PbEncodeError>) -> PbBuilder
    match r
        Ok(b)  => b
        Err(e) =>
            test.fail(e.message())
            pbwrite.builder(pbwrite.build_limits())

fn builder_refusal(r: Result<PbBuilder, PbEncodeError>) -> PbEncodeError
    match r
        Ok(_)  =>
            test.fail("expected a refusal")
            PbBadFieldNumber(field: 0 - 1)
        Err(e) => e

@test
fn test_a_refusal_moves_into_the_outer_message()
    let all = [PbTruncated(at: 1, need: 2), PbVarintOverflow(at: 1, bytes: 11),
        PbUnknownWireType(at: 1, wire: 6), PbZeroFieldNumber(at: 1),
        PbFieldNumberTooLarge(at: 1, field: 536870912), PbLengthOverrun(at: 1, len: 9, left: 2),
        PbLengthNotRepresentable(at: 1), PbDepthExceeded(at: 1, limit: 3),
        PbGroupMismatch(at: 1, closed: 2, open: 3), PbUnclosedGroup(at: 1, field: 4),
        PbNotUtf8(at: 1, byte: 255), PbPackedRemainder(at: 1, left: 2),
        PbMessageTooLarge(at: 1, len: 9, limit: 8), PbTrailingBytes(at: 1, left: 2),
        PbNoSuchType(at: 1, name: ".x.Y"), PbTransport(at: 1, cause: IoClosed)]
    for e in all
        let moved = pberr.shifted(e, 10)
        test.assert_eq(pberr.decode_offset(moved), 11)

@test
fn test_a_group_slot_is_reused_after_the_group_closes()
    // Group 1 opens and closes, then group 2 opens and closes.
    match pbread.walk(hex("0b0c1314"), pbread.default_limits())
        Ok(evs) => test.assert_eq(evs.len(), 4)
        Err(e)  => test.fail(e.message())

// ── sizes ───────────────────────────────────────────────────────────

@test
fn test_a_packed_payload_sizes_each_element_by_its_type()
    test.assert_eq(pbwrite.packed_payload_len(PbTypeSint64, [0 - 1, 1]), 2)
    test.assert_eq(pbwrite.packed_payload_len(PbTypeUint64, [0 - 1]), 10)
    test.assert_eq(pbwrite.packed_payload_len(PbTypeBool, [1, 0, 1]), 3)
    test.assert_eq(pbwrite.packed_payload_len(PbTypeEnum, [0 - 1]), 10)
    test.assert_eq(pbwrite.packed_payload_len(PbTypeSint32, [0 - 1]), 1)
    test.assert_eq(pbwrite.packed_payload_len(PbTypeFixed32, [1, 2]), 8)

// ── the field writers ───────────────────────────────────────────────

@test
fn test_a_field_number_is_checked_before_the_room()
    var c = bytes.cursor_le(bytes.zeros(0))
    test.assert_eq(refusal(pbwrite.write_varint_field(0, 1, c)) == PbBadFieldNumber(field: 0), true)
    test.assert_eq(refusal(pbwrite.write_varint_field(19000, 1, c)) == PbReservedFieldNumber(field: 19000), true)
    test.assert_eq(refusal(pbwrite.write_varint_field(1, 1, c)) == PbBufferTooSmall(need: 2, left: 0), true)

@test
fn test_a_value_its_type_cannot_carry_is_refused_with_its_field()
    var c = bytes.cursor_le(bytes.zeros(64))
    test.assert_eq(refusal(pbwrite.write_sint32_field(3, 2147483648, c)) == PbValueOutOfRange(field: 3, value: 2147483648),
        true)
    test.assert_eq(refusal(pbwrite.write_fixed32_field(4, 0 - 2147483649, c)) == PbValueOutOfRange(field: 4, value: 0 - 2147483649),
        true)
    test.assert_eq(refusal(pbwrite.write_packed_field(5, PbTypeString, [1], c)) == PbValueOutOfRange(field: 5, value: 9),
        true)
    test.assert_eq(refusal(pbwrite.write_packed_field(6, PbTypeInt32, [2147483648], c)) == PbValueOutOfRange(field: 6, value: 2147483648),
        true)
    test.assert_eq(refusal(pbwrite.write_packed_field(6, PbTypeUint32, [0 - 1], c)) == PbValueOutOfRange(field: 6, value: 0 - 1),
        true)
    test.assert_eq(refusal(pbwrite.write_packed_field(6, PbTypeBool, [2], c)) == PbValueOutOfRange(field: 6, value: 2),
        true)
    test.assert_eq(refusal(pbwrite.write_packed_field(6, PbTypeSfixed32, [0 - 2147483649], c)) == PbValueOutOfRange(field: 6, value: 0 - 2147483649),
        true)
    test.assert_eq(c.pos(), 0)

@test
fn test_a_string_that_is_not_utf8_is_refused_at_its_bad_byte()
    var c = bytes.cursor_le(bytes.zeros(16))
    let s = bytes.to_str(hex("61ff"))
    test.assert_eq(refusal(pbwrite.write_string_field(2, s, c)) == PbEncodeNotUtf8(field: 2, at: 1), true)

@test
fn test_every_packable_type_writes_its_own_width()
    let types = [PbTypeInt32, PbTypeEnum, PbTypeSint32, PbTypeSint64, PbTypeFixed32,
        PbTypeSfixed32, PbTypeFloat, PbTypeFixed64, PbTypeSfixed64, PbTypeDouble, PbTypeUint64,
        PbTypeBool]
    let widths = [2, 2, 2, 2, 8, 8, 8, 16, 16, 16, 2, 2]
    for i in 0..list.len(types)
        var c = bytes.cursor_le(bytes.zeros(32))
        match pbwrite.write_packed_field(1, types[i], [1, 0], c)
            Ok(n)  => test.assert_eq(n, 2 + widths[i])
            Err(e) => test.fail(e.message())

@test
fn test_the_repeated_writers_check_the_room_for_every_element()
    var c = bytes.cursor_le(bytes.zeros(3))
    test.assert_eq(refusal(pbwrite.write_repeated_varint_field(1, [1, 2], c)) == PbBufferTooSmall(need: 4, left: 3),
        true)
    test.assert_eq(refusal(pbwrite.write_group_field(1, hex("0801"), c)) == PbBufferTooSmall(need: 4, left: 3),
        true)
    test.assert_eq(refusal(pbwrite.write_packed_field(1, PbTypeInt32, [1, 2], c)) == PbBufferTooSmall(need: 4, left: 3),
        true)

// ── the builder ─────────────────────────────────────────────────────

@test
fn test_the_builder_refuses_nesting_past_its_depth()
    let b = pbwrite.builder(PbBuildLimits { max_depth: 1, max_message: 100 })
    let one = built(pbwrite.begin(b, 1))
    test.assert_eq(builder_refusal(pbwrite.begin(one, 2)) == PbEncodeDepthExceeded(limit: 1), true)
    test.assert_eq(builder_refusal(pbwrite.begin(b, 0)) == PbBadFieldNumber(field: 0), true)
    match pbwrite.done(one)
        Ok(_)  => test.fail("a submessage is open")
        Err(e) => test.assert_eq(e == PbEncodeDepthExceeded(limit: 1), true)

@test
fn test_the_builder_refuses_a_level_past_its_size()
    let b = pbwrite.builder(PbBuildLimits { max_depth: 4, max_message: 4 })
    let a = built(pbwrite.put_varint(b, 1, 1))
    test.assert_eq(pbwrite.builder_len(a), 2)
    test.assert_eq(builder_refusal(pbwrite.put_string(a, 2, "abc")) == PbBufferTooSmall(need: 7, left: 4), true)

@test
fn test_the_builder_s_fixed_and_packed_puts_check_their_type()
    let b = pbwrite.builder(pbwrite.build_limits())
    test.assert_eq(builder_refusal(pbwrite.put_fixed(b, 1, PbTypeInt32, 1)) == PbValueOutOfRange(field: 1, value: 5),
        true)
    test.assert_eq(builder_refusal(pbwrite.put_fixed(b, 1, PbTypeFixed32, 0 - 1)) == PbValueOutOfRange(field: 1, value: 0 - 1),
        true)
    test.assert_eq(builder_refusal(pbwrite.put_packed(b, 1, PbTypeBytes, [1])) == PbValueOutOfRange(field: 1, value: 12),
        true)
    let f = built(pbwrite.put_fixed(b, 1, PbTypeDouble, float.to_bits(1.0)))
    match pbwrite.done(f)
        Ok(out) => test.assert_eq(bytes.to_hex(out), "09000000000000f03f")
        Err(e)  => test.fail(e.message())

fn close_nothing()
    let b = pbwrite.builder(pbwrite.build_limits())
    let _ = pbwrite.end(b)

@test
fn test_closing_what_was_never_opened_is_a_mistake_in_the_program()
    test.assert_raises(close_nothing)
