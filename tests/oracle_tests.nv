// tests/oracle_tests.nv — this package against protoc and Google's
// protobuf module.
//
// The vectors at the end of this file are the descriptor sets protoc
// wrote for tests/proto and the messages Python serialised from them.  A set read
// here and written back must be protoc's bytes, and a message decoded
// here and encoded again must be Python's bytes.

use std.test
use std.bytes
use pbwire
use pbread
use pbunknown
use pbdesc
use pbdyn
use pbgen
use pberr

fn hex(h: Str) -> Bytes
    bytes.from_hex(h) ?? bytes.zeros(0)

fn order_set() -> PbFileSet
    match pbdesc.parse_file_set(hex(order_set_hex()), pbread.default_limits())
        Ok(s)  => s
        Err(e) =>
            test.fail(e.message())
            PbFileSet { files: [] }

fn legacy_set() -> PbFileSet
    match pbdesc.parse_file_set(hex(legacy_set_hex()), pbread.default_limits())
        Ok(s)  => s
        Err(e) =>
            test.fail(e.message())
            PbFileSet { files: [] }

// A message with nothing in it, for a lookup that fails.
fn no_message() -> PbMessage
    PbMessage { name: "", full_name: "", fields: [], oneofs: [], nested: [], enums: [],
        extensions: [], extension_ranges: [], reserved_ranges: [], reserved_names: [],
        map_entry: false, deprecated: false, unknown: pbunknown.empty() }

fn order() -> PbMessage
    let set = order_set()
    let Some(m) = pbdesc.find_message(set, ".acme.Order") else return no_message()
    m

fn field(name: Str) -> PbField
    let m = order()
    let Some(f) = pbdesc.field_by_name(m, name) else return pbdesc.field_by_number(m, 1) ?? m.fields[0]
    f

@test
fn test_protoc_s_descriptor_set_reads_with_its_import_first()
    let set = order_set()
    test.assert_eq(set.files.len(), 2)
    let money = set.files[0]
    let order = set.files[1]
    test.assert_eq(money.name, "acme/money.proto")
    test.assert_eq(order.name, "acme/order.proto")
    test.assert_eq(order.dependency[0], "acme/money.proto")
    test.assert_eq(pbdesc.syntax_name(order.syntax), "proto3")
    test.assert_eq(order.package, "acme")
    test.assert_eq(pbdesc.validate(set).len(), 0)

@test
fn test_a_set_written_back_is_protoc_s_own_bytes()
    match pbdesc.write_file_set(order_set())
        Ok(raw) => test.assert_eq(bytes.to_hex(raw), order_set_hex())
        Err(e)  => test.fail(e.message())
    match pbdesc.write_file_set(legacy_set())
        Ok(raw) => test.assert_eq(bytes.to_hex(raw), legacy_set_hex())
        Err(e)  => test.fail(e.message())

@test
fn test_the_fields_read_as_descriptor_proto_says()
    let m = order()
    test.assert_eq(m.fields.len(), 30)
    test.assert_eq(field("deltas").field_type == PbTypeSint32, true)
    test.assert_eq(pbdesc.packed_of(field("deltas"), PbProto3), true)
    test.assert_eq(pbdesc.packed_of(field("loose"), PbProto3), false)
    test.assert_eq(field("loose").packed_set, true)
    test.assert_eq(field("total").type_name, ".acme.Money")
    test.assert_eq(field("f32").json_name, "f32")
    test.assert_eq(field("sf64").json_name, "sf64")
    test.assert_eq(pbdesc.has_presence(field("gift"), PbProto3), true)
    test.assert_eq(pbdesc.has_presence(field("id"), PbProto3), false)
    test.assert_eq(m.reserved_ranges[0].first, 100)
    test.assert_eq(m.reserved_ranges[0].last, 105)
    test.assert_eq(m.reserved_names[0], "legacy")

@test
fn test_oneofs_real_and_synthetic()
    let m = order()
    test.assert_eq(m.oneofs.len(), 3)
    test.assert_eq(m.oneofs[0].name, "payment")
    test.assert_eq(m.oneofs[0].synthetic, false)
    test.assert_eq(m.oneofs[1].synthetic, true)
    test.assert_eq(m.oneofs[2].synthetic, true)
    test.assert_eq(pbdesc.oneof_fields(m, 0).len(), 3)

@test
fn test_maps_are_found_through_their_entry_messages()
    let set = order_set()
    test.assert_eq(pbdesc.is_map_field(set, field("tags")), true)
    test.assert_eq(pbdesc.is_map_field(set, field("items")), false)
    match pbdesc.map_key_field(set, field("ledger"))
        Some(k) => test.assert_eq(k.field_type == PbTypeInt64, true)
        None    => test.fail("ledger is a map")
    match pbdesc.map_value_field(set, field("ledger"))
        Some(v) => test.assert_eq(v.type_name, ".acme.Money")
        None    => test.fail("ledger is a map")
    match pbdesc.find_message(set, ".acme.Order.TagsEntry")
        Some(e) => test.assert_eq(e.map_entry, true)
        None    => test.fail("protoc makes TagsEntry")

@test
fn test_enums_and_services_read_whole()
    let set = order_set()
    match pbdesc.find_enum(set, ".acme.Currency")
        Some(e) =>
            test.assert_eq(e.values.len(), 4)
            test.assert_eq(e.values[3].number, 0 - 3)
            test.assert_eq(e.zero_value, "CURRENCY_UNSPECIFIED")
        None    => test.fail("the set declares .acme.Currency")
    match pbdesc.find_service(set, ".acme.Orders")
        Some(s) =>
            match pbdesc.find_method(s, "Watch")
                Some(w) =>
                    test.assert_eq(w.streaming == PbServerStream, true)
                    test.assert_eq(w.input_type, ".acme.Order")
                None    => test.fail("Orders declares Watch")
        None    => test.fail("the set declares .acme.Orders")

@test
fn test_proto2_groups_defaults_and_extensions()
    let set = legacy_set()
    let f = set.files[0]
    test.assert_eq(pbdesc.syntax_name(f.syntax), "proto2")
    test.assert_eq(pbdesc.has_extensions(f), true)
    test.assert_eq(f.extensions[0].extendee, ".legacy.Old")
    match pbdesc.find_message(set, ".legacy.Old")
        Some(m) =>
            test.assert_eq(m.extension_ranges[0].first, 100)
            test.assert_eq(m.extension_ranges[0].last, 199)
            match pbdesc.field_by_name(m, "label")
                Some(l) => test.assert_eq(l.default_value, "none")
                None    => test.fail("Old declares label")
            match pbdesc.field_by_number(m, 4)
                Some(g) => test.assert_eq(g.field_type == PbTypeGroup, true)
                None    => test.fail("Old declares the group Extra")
        None    => test.fail("the set declares .legacy.Old")
    test.assert_eq(pbdesc.validate(set).len(), 0)

// ── the dynamic message against Python's bytes ──────────────────────

fn decoded(set: PbFileSet, name: Str, h: Str) -> PbDynamic
    match pbdyn.decode(set, name, hex(h), pbread.default_limits())
        Ok(m)  => m
        Err(e) =>
            test.fail(e.message())
            pbdyn.message(name)

fn reencoded(set: PbFileSet, m: PbDynamic) -> Str
    match pbdyn.encode(set, m)
        Ok(b)  => bytes.to_hex(b)
        Err(e) =>
            test.fail(e.message())
            ""

@test
fn test_python_s_messages_decode_and_encode_back_to_the_same_bytes()
    let set = order_set()
    for h in [order_full_hex(), order_empty_hex(),
              order_voucher_hex(), order_unknown_hex()]
        test.assert_eq(reencoded(set, decoded(set, ".acme.Order", h)), h)
    let legacy = legacy_set()
    let old = decoded(legacy, ".legacy.Old", legacy_old_hex())
    test.assert_eq(reencoded(legacy, old), legacy_old_hex())

@test
fn test_python_s_values_read_as_the_numbers_python_wrote()
    let set = order_set()
    let m = decoded(set, ".acme.Order", order_full_hex())
    test.assert_eq(pbdyn.get(m, 1) == Some(PbNum(v: 150)), true)
    test.assert_eq(pbdyn.get(m, 2) == Some(PbText(v: "testing")), true)
    test.assert_eq(pbdyn.get(m, 14) == Some(PbNum(v: 4294967295)), true)
    match pbdyn.get(m, 15)
        Some(PbNum(v)) => test.assert_eq(pbdyn.uint64_text(v), "18446744073709551615")
        _              => test.fail("big is a uint64")
    test.assert_eq(pbdyn.get(m, 16) == Some(PbNum(v: 0 - 9223372036854775807 - 1)), true)
    test.assert_eq(pbdyn.get(m, 12) == Some(PbReal(v: 1.5)), true)
    test.assert_eq(pbdyn.get(m, 25) == Some(PbEnumOf(number: 0 - 3, name: "CURRENCY_OLD")), true)
    match pbdyn.get(m, 4)
        Some(PbList(items)) => test.assert_eq(items[1] == PbNum(v: 0 - 270), true)
        _                   => test.fail("deltas is repeated")
    match pbdyn.get(m, 5)
        Some(PbMap(entries)) =>
            test.assert_eq(entries[0].key == PbText(v: "a"), true)
            test.assert_eq(entries[0].value == PbNum(v: 1), true)
        _                    => test.fail("tags is a map")
    match pbdyn.get(m, 3)
        Some(PbNested(total)) => test.assert_eq(pbdyn.get(total, 3) == Some(PbNum(v: 0 - 2147483648)), true)
        _                     => test.fail("total is a message")
    test.assert_eq(pbdyn.which_oneof(set, m, "payment") == Some(6), true)
    test.assert_eq(pbdyn.has(m, 8), true)
    test.assert_eq(pbdyn.get_by_name(set, m, "loop") == Some(PbFlag(v: true)), true)

@test
fn test_fields_a_schema_does_not_declare_travel_on()
    let set = order_set()
    let m = decoded(set, ".acme.Order", order_unknown_hex())
    test.assert_eq(pbunknown.count(m.unknown), 2)
    test.assert_eq(pbunknown.has_number(m.unknown, 111), true)

@test
fn test_a_proto2_group_and_an_extension_read_by_descriptor()
    let set = legacy_set()
    let m = decoded(set, ".legacy.Old", legacy_old_hex())
    match pbdyn.get(m, 4)
        Some(PbNested(g)) => test.assert_eq(pbdyn.get(g, 5) == Some(PbNum(v: 9)), true)
        _                 => test.fail("Extra is a group")
    // The extension is not a field of Old, so it is kept.
    test.assert_eq(pbunknown.has_number(m.unknown, 100), true)
    test.assert_eq(pbdyn.get(m, 2) == Some(PbText(v: "hi")), true)

// ── the generator over protoc's set ─────────────────────────────────

@test
fn test_the_generator_writes_a_module_per_file_and_per_service()
    match pbgen.generate_set(order_set(), pbgen.default_options())
        Ok(out) =>
            test.assert_eq(out.len(), 3)
            test.assert_eq(out[0].module, "acme_money")
            test.assert_eq(out[1].path, "acme_order.nv")
            test.assert_eq(out[2].module, "acme_order_orders")
            test.assert_eq(str.contains(out[1].source, "pub struct AcmeOrder\n"), true)
            test.assert_eq(str.contains(out[1].source, "var loop_: Bool"), true)
            test.assert_eq(str.contains(out[1].source, "use acme_money"), true)
            test.assert_eq(str.contains(out[1].source, "acme_money.decode_acme_money("), true)
            test.assert_eq(str.contains(out[0].source, "AcmeCurrencyOld         => 0 - 3"), true)
            test.assert_eq(str.contains(out[2].source, "\"/acme.Orders/Watch\""), true)
        Err(e)  => test.fail(e.message())

@test
fn test_the_generator_refuses_a_group_and_an_extension()
    let set = legacy_set()
    let f = set.files[0]
    let rs = pbgen.refusals(f)
    test.assert_eq(rs.len(), 2)
    test.assert_eq(pberr.schema_path(rs[0]), "flavour")
    test.assert_eq(pberr.schema_path(rs[1]), "legacy.Old.extra")
    test.assert_eq(pbgen.generate(f).len(), 0)
    match pbgen.generate_set(legacy_set(), pbgen.default_options())
        Ok(_)  => test.fail("an extension is not generated")
        Err(e) => test.assert_eq(str.contains(e.message(), "an extension"), true)

// ── the vectors: protoc's descriptor sets and Python's messages ──
//
// tools/vectors.py writes everything below this line from tests/proto.

// The descriptor set of legacy, with its imports.
fn legacy_set_hex() -> Str
    ""

// The descriptor set of order, with its imports.
fn order_set_hex() -> Str
    ""

// The message legacy_old.
fn legacy_old_hex() -> Str
    "0805120268691801180223280924a00603"

// The message order_empty.
fn order_empty_hex() -> Str
    ""

// The message order_full.
fn order_full_hex() -> Str
    ""

// The message order_unknown.
fn order_unknown_hex() -> Str
    "0801f8060a8a0703616263"

// The message order_voucher.
fn order_voucher_hex() -> Str
    "08ffffffffffffffffff01a201020802"
